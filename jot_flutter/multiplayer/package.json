{
  "name": "jot-multiplayer",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "python3 ../tools/build_server_core.py",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run test:integration && npm run test:coverage",
    "test:integration": "npm run build && node --test test/rooms.test.mjs",
    "test:coverage": "node test/coverage-run.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "miniflare": "5.20261006.0-alpha",
    "typescript": "6.0.3",
    "wrangler": "4.148.0",
    "ws": "^8.22.0"
  }
}
